doctype html
html(lang="fr")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    script(defer, src="../js/alpinejs-csp.js")
    title Extension PureScript
    style.
        body {
            width: 300px;
            padding: 20px;
            font-family: Arial, sans-serif;
            margin: 0;
        }
        .header {
            text-align: center;
            margin-bottom: 20px;
            color: #333;
        }
        .button {
            background: #4CAF50;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            width: 100%;
            margin-bottom: 10px;
        }
        .button:hover {
            background: #45a049;
        }
        .status {
            text-align: center;
            margin-top: 15px;
            padding: 10px;
            border-radius: 4px;
            display: none;
        }
        .status.success {
            background: #d4edda;
            color: #155724;
        }
        .status.error {
            background: #f8d7da;
            color: #721c24;
        }
        .status.show {
            display: block;
        }

  body(x-data="popupData()")
    .header
      h1 Mon Extension
      p Powered by PureScript & Pug

    .controls
      button.button(x-on:click="handleMainAction") Action principale
      button.button(x-on:click="handleSettingsAction") Paramètres
      button.button(x-on:click="handleAboutAction") About

    .status(x-bind:class="getStatusClasses()" x-show="isStatusVisible")
      span(x-text="statusMessage")

    script.
      function popupData() {
        return {
          statusMessage: '',
          statusType: '',
          isStatusVisible: false,

          // Méthode pour calculer les classes CSS
          getStatusClasses: function() {
            var classes = 'status';
            if (this.statusType) {
              classes += ' ' + this.statusType;
            }
            if (this.isStatusVisible) {
              classes += ' show';
            }
            return classes;
          },

          // Méthode d'initialisation
          init: function() {
            console.log('🚀 Popup Alpine CSP initialisé');
          },

          // Méthode pour afficher un statut
          showStatus: function(message, type) {
            this.statusMessage = message;
            this.statusType = type;
            this.isStatusVisible = true;

            var self = this;
            setTimeout(function() {
              self.isStatusVisible = false;
            }, 3000);
          },

          // Gestionnaires d'événements
          handleMainAction: function() {
            console.log('Action principale déclenchée');
            this.showStatus('Action exécutée avec succès!', 'success');
          },

          handleSettingsAction: function() {
            console.log('Ouverture des paramètres');
            this.showStatus('Paramètres en cours de développement', 'error');
          },

          handleAboutAction: function() {
            console.log('À propos de l\'extension');
            this.showStatus('Extension PureScript v1.0.0', 'success');
          }
        };
      }
