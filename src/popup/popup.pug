doctype html
html(lang="fr")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Popup - Mon Extension
    link(rel="stylesheet" href="../styles/main.css")

  body.popup
    .container
      header
        h1 Mon Extension
        p Configuration rapide

      main
        .form-group
          label(for="enabled-toggle")
            input#enabled-toggle(type="checkbox")
            span Extension activée

        .form-group
          label(for="theme-select") Thème :
          select#theme-select
            option(value="light") Clair
            option(value="dark") Sombre

        .actions
          button#save-button.primary Sauvegarder

        .status#status

    script(src="popup.js")
