{
  "name": "Mon Extension Civet",
  "{{chrome}}.manifest_version": 3,
  "{{firefox}}.manifest_version": 2,
  "permissions": [
    "activeTab",
    "storage"
  ],
  "background": {
    "{{firefox}}.scripts": ["Background/background.civet"],
    "{{chrome}}.service_worker": "Background/background.civet"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["Content/content.civet"]
    }
  ],
  "{{firefox}}.browser_action": {
    "default_popup": "Popup/popup.pug",
    "default_title": "Mon Extension",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "{{chrome}}.action": {
    "default_popup": "Popup/popup.pug",
    "default_title": "Mon Extension",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}
