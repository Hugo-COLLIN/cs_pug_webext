{
  "manifest_version": 3,
  "name": "Mon Extension CoffeeScript",
  "version": "1.0.0",
  "description": "Extension développée avec CoffeeScript, Pug et esBuild",

  "permissions": [
    "storage",
    "activeTab"
  ],

  "background": {
    "scripts": ["background/background.js"]
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"]
    }
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Mon Extension"
  },

  "options_page": "options/options.html",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
