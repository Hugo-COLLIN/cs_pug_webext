{
  "name": "cs_pug_webext",
  "version": "1.0.0",
  "description": "Extension de navigateur créée avec PureScript et Pug",
  "scripts": {
    "build:pug": "pug templates/ -o dist/",
    "build:purescript": "spago build",
    "build:bundle": "node config/esbuild.config.js",
    "build": "npm run build:pug && npm run build:purescript && npm run build:bundle",
    "watch:pug": "pug templates/ -o dist/ --watch",
    "watch:purescript": "spago build --watch",
    "watch:bundle": "node config/esbuild.config.js --watch",
    "watch": "concurrently \"npm run watch:pug\" \"npm run watch:purescript\" \"npm run watch:bundle\"",
    "build:chrome": "cross-env TARGET_BROWSER=chrome npm run build",
    "build:firefox": "cross-env TARGET_BROWSER=firefox npm run build",
    "dev:chrome": "cross-env TARGET_BROWSER=chrome npm run watch",
    "dev:firefox": "cross-env TARGET_BROWSER=firefox npm run watch"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^10.0.0",
    "esbuild": "^0.25.10",
    "esbuild-plugin-copy": "^2.1.1",
    "mkdirp": "^3.0.1",
    "pug": "^3.0.3",
    "pug-cli": "^1.0.0-alpha6"
  }
}
